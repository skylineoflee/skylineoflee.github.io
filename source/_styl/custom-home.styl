    text-align center !important
    margin 0.3rem 0 !important

// 5) markdown-body 正文
.markdown-body
  background transparent !important
  color $text-main !important
  font-size 15.5px !important
  line-height 1.8 !important
  margin-bottom 1.5rem !important

  p
    color $text-main !important
    margin 1.1em 0 !important

  > h2
    color $text-main !important
    font-size 1.4rem !important
    font-weight 700 !important
    margin 1.8em 0 0.7em !important
    padding-bottom 0.4em !important
    border-bottom 1px solid $border-green !important

  > h3
    color $neon-green !important
    font-size 1.2rem !important
    font-weight 600 !important
    margin 1.5em 0 0.6em !important

  > h4, > h5, > h6
    color $text-dim !important
    font-weight 600 !important
    margin 1.3em 0 0.5em !important

  a
    color $neon-green !important
    border-bottom 1px dashed $neon-green-line !important
    transition all 0.2s !important

    &:hover
      color lighten($neon-green, 15%) !important
      border-bottom-color rgba(255, 255, 255, 0.5) !important

  strong
    color #fff !important
    font-weight 600 !important

  code
    background rgba(255, 255, 255, 0.08) !important
    color $neon-green !important
    padding 3px 8px !important
    border-radius 6px !important
    font-size 0.9em !important
    border 1px solid $neon-green-line !important

  pre
    background rgba(15, 15, 17, 0.95) !important
    background-color rgba(15, 15, 17, 0.95) !important
    border none !important
    border-radius 12px !important
    padding 1.25rem 1.5rem !important
    margin 1.2em 0 !important
    box-shadow 0 4px 20px rgba(0, 0, 0, 0.4) !important

    code
      background transparent !important
      background-color transparent !important
      border none !important
      padding 0 !important
      color #E8E8EA !important

  .hljs
    background rgba(15, 15, 17, 0.95) !important
    background-color rgba(15, 15, 17, 0.95) !important
    color #ABB2BF !important

  .code-widget
    background rgba(15, 15, 17, 0.95) !important
    background-color rgba(15, 15, 17, 0.95) !important
    color $neon-green !important
    border none !important
    border-bottom none !important
    border-radius 12px 12px 0 0 !important

  .hljs-ln-line
    color $text-dim !important

  .hljs-ln
    background transparent !important

  &::before, &::after
    display none !important
    content none !important

  blockquote
    background rgba(255, 255, 255, 0.03) !important
    border-left 3px solid rgba(255, 255, 255, 0.25) !important
    color $text-dim !important
    margin 1.2em 0 !important
    padding 1em 1.25em !important
    border-radius 0 12px 12px 0 !important

  ul, ol
    color $text-main !important
    padding-left 1.6em !important

    li
      margin 0.5em 0 !important

  table
    background rgba(20, 20, 22, 0.5) !important
    border-collapse collapse !important
    width 100% !important
    margin 1.2em 0 !important
    border-radius 8px !important
    overflow hidden

    th, td
      border none !important
      padding 10px 14px !important
      color $text-main !important

    th
      background rgba(255, 255, 255, 0.05) !important
      color $neon-green !important
      font-weight 600 !important

    tr:nth-child(2n)
      background rgba(255, 255, 255, 0.02) !important

  hr
    border-color $border-line !important
    margin 2.5em 0 !important

// 6) 元信息
.post-metas
  color $text-dim !important

  .post-meta
    color $text-dim !important

// 7) 目录侧边栏
#toc
  .toc-header
    color $neon-green !important
    font-weight 600 !important

  .toc-body
    a
      color $text-dim !important
      border-bottom none !important

      &:hover
        color $neon-green !important

  .toc-list
    margin 0 !important
    padding 0 !important
    list-style none !important

  .toc-list-item
    margin 0 !important
    padding 8px 0 !important
    line-height 1.6 !important

  .toc-link
    line-height 1.6 !important
    padding 5px 0 !important
    display block !important
    border-radius 4px !important
    transition all 0.2s !important

    &:hover
      background rgba(255, 255, 255, 0.05) !important
      padding-left 8px !important

  .toc-list .toc-list
    padding-left 16px !important

  .toc-list .toc-list .toc-list
    padding-left 16px !important

  .iconfont.icon-list
    &::before
      content "≡" !important
      font-style normal !important
      font-weight bold !important
      font-size 1.1em !important
      color $neon-green !important

// 8) 上一/下一篇文章
.post-prevnext
  a
    background transparent !important
    border none !important
    color $text-main !important
    border-radius 12px !important
    transition all 0.25s !important
    padding 1rem 1.25rem !important

    &:hover
      border-color rgba(255, 255, 255, 0.3) !important
      box-shadow none !important
      transform translateY(-2px)

// ============================================================================
// 全局扫白
// ============================================================================
html body kbd
  background rgba(255, 255, 255, 0.05) !important
  color $neon-green !important
  border 1px solid rgba(255, 255, 255, 0.18) !important
  border-radius 6px !important
  box-shadow none !important
  padding 3px 8px !important

html body samp, html body var
  color $neon-green !important

html body mark
  background rgba(255, 255, 255, 0.1) !important
  color #fff !important
  padding 2px 6px !important
  border-radius 4px !important

html body .markdown-body *
  border-color $border-line !important

html body .markdown-body pre table
  background transparent !important
  border none !important

html body .markdown-body pre table td
  background transparent !important
  border none !important
  padding 0 !important
  color $text-main !important

html body .markdown-body
  box-shadow none !important
  border none !important
  outline none !important

html body pre
  background rgba(15, 15, 17, 0.95) !important
  background-color rgba(15, 15, 17, 0.95) !important

html body code
  color #ABB2BF !important

// ============================================================================
// navbar 品牌区
// ============================================================================
.navbar-brand
  display flex !important
  align-items center !important
  gap 10px !important

  .navbar-brand-avatar
    width 32px
    height 32px
    border-radius 50%
    object-fit cover
    border 2px solid $neon-green-line
    flex-shrink 0
    box-shadow 0 0 12px $neon-green-soft

  strong
    line-height 1
    color $text-main !important

// 导航链接
.navbar .nav-link
  color $text-dim !important
  transition all 0.2s !important
  border-radius 8px !important
  padding 8px 14px !important

  &:hover, &.active
    color $neon-green !important
    background rgba(255, 255, 255, 0.06) !important

// 导航栏右上角用户区（头像 + 昵称）
.navbar .nav-user-item
  margin-left 6px

.navbar .nav-user
  display flex !important
  align-items center !important
  gap 8px !important
  padding 4px 10px 4px 4px !important
  border-radius 999px !important
  background rgba(255, 255, 255, 0.05) !important
  border 1px solid rgba(255, 255, 255, 0.08) !important
  transition all 0.25s !important

  &:hover
    background rgba(255, 255, 255, 0.08) !important
    border-color rgba(255, 255, 255, 0.25) !important
    box-shadow none !important

.navbar .nav-user-avatar
  width 30px !important
  height 30px !important
  border-radius 50% !important
  object-fit cover !important
  border 2px solid rgba(255, 255, 255, 0.25) !important
  box-shadow none !important
  flex-shrink 0 !important

.navbar .nav-user-name
  font-size 13px !important
  color $text-main !important
  font-weight 600 !important
  line-height 1 !important
  white-space nowrap !important

  @media (max-width 991px)
    display none !important

// ============================================================================
// footer 统计
// ============================================================================
.footer-inner .statistics
  display flex !important
  justify-content center !important
  align-items center !important
  gap 16px !important

  & > span
    flex none !important
    margin 0 !important
    text-align center !important
    color $text-dim !important
    font-size 13px

// 页脚整体
footer
  background transparent !important
  border-top 1px solid rgba(255, 255, 255, 0.06) !important
  margin-top 60px !important

  .footer-inner
    color $text-dim !important
    padding 2rem 0 !important

    a
      color $neon-green !important
      transition all 0.2s

      &:hover
        color lighten($neon-green, 15%) !important

// 小标签不需要 tooltip
.tile-tag, .chip, .module-name-en, .tile-platform, .tile-rating, .tile-status
  &::after
    display none !important

// ============================================================================
// ============================================================================
// 全站页面卡片风格对齐（归档 / 标签 / 分类 / 友链 / 关于 / 404）
// 风格：与首页 .tile 玻璃拟态卡片一致
// ============================================================================

// --- 导航栏：与 .tile 卡片同款磨砂玻璃质感，贴顶无缝隙 ---
//       关键：isolation: isolate 创建独立渲染层，玻璃叠加不会被穿透
// --- 导航栏：最高优先级，永远在最上层 ---
.navbar, header.navbar
  top 0 !important
  right 0 !important
  left 0 !important
  position fixed !important
  z-index 2147483647 !important
  // 强制创建独立 GPU 合成层，确保渲染在最顶端
  transform translateZ(0) !important
  will-change transform !important
  // 限制渲染影响范围，避免被外部样式干扰
  contain layout style paint !important
  isolation isolate !important
  background linear-gradient(180deg, #24272D 0%, #16181C 100%) !important
  backdrop-filter blur(26px) saturate(135%) !important
  -webkit-backdrop-filter blur(26px) saturate(135%) !important
  border-bottom 1px solid rgba(255, 255, 255, 0.06) !important
  box-shadow 0 8px 32px rgba(0, 0, 0, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.1) !important
  border-radius 0 0 20px 20px !important
  margin 0 !important
  width 100% !important
  max-width 100% !important

  &.scrolling-navbar.top-nav-collapse
    background linear-gradient(180deg, #24272D 0%, #16181C 100%) !important
    backdrop-filter blur(26px) saturate(135%) !important
    box-shadow 0 8px 32px rgba(0, 0, 0, 0.55), inset 0 1px 0 rgba(255, 255, 255, 0.12) !important

// --- 修复：搜索 modal 打开时，导航栏让位给 modal ---
//      navbar 用 z-index 2147483647 保持常驻最上层，但 modal(1050)
//      在 <main>(z-index 1) 内无法压过它；modal 打开时降级到 1040。
body.modal-open .navbar,
body.modal-open header.navbar
  z-index 1040 !important

// --- 1) 归档页：列表容器透明 + 每项玻璃卡片 ---
.list-group
  background transparent !important

.list-group .list-group-item
  position relative
  overflow hidden
  background linear-gradient(180deg, rgba(36, 39, 45, 0.5) 0%, rgba(22, 24, 28, 0.68) 100%) !important
  border 1px solid rgba(255, 255, 255, 0.06) !important
  border-radius 16px !important
  box-shadow 0 6px 24px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.08) !important
  color $text-main !important
  margin-bottom 12px !important
  padding 1rem 1.25rem !important
  transition all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important

  &::before
    content ''
    position absolute
    top 0
    left 0
    right 0
    height 6px
    background linear-gradient(180deg, rgba(255, 255, 255, 0.22) 0%, rgba(255, 255, 255, 0.04) 60%, transparent 100%)
    z-index 3
    pointer-events none

  &::after
    content ''
    position absolute
    bottom -80px
    right -60px
    width 280px
    height 280px
    border-radius 50%
    background radial-gradient(circle at center, rgba(255, 255, 255, 0.09) 0%, rgba(255, 255, 255, 0.03) 30%, transparent 70%)
    pointer-events none
    z-index 1

  &:hover, &:focus
    border-color rgba(255, 255, 255, 0.22) !important
    background linear-gradient(180deg, rgba(40, 44, 50, 0.6) 0%, rgba(26, 28, 32, 0.76) 100%) !important
    transform translateY(-2px) !important
    box-shadow 0 10px 28px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.1) !important

  .list-group-item-title
    color $text-main !important

    &:hover
      color $neon-green !important

// 归档页分组标题
.list-group h2, .list-group h5
  color $neon-green !important
  border-bottom-color rgba(255, 255, 255, 0.15) !important

// --- 2) 标签页：标签云玻璃卡片 ---
.tagcloud
  position relative
  overflow hidden
  background linear-gradient(180deg, rgba(36, 39, 45, 0.5) 0%, rgba(22, 24, 28, 0.68) 100%) !important
  border 1px solid rgba(255, 255, 255, 0.06) !important
  border-radius 24px !important
  box-shadow 0 8px 32px rgba(0, 0, 0, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.08) !important
  backdrop-filter blur(26px) saturate(135%) !important
  -webkit-backdrop-filter blur(26px) saturate(135%) !important
  padding 3rem 2rem !important
  margin 1rem 0 2rem !important
  transition all 0.3s ease !important

  &::before
    content ''
    position absolute
    top 0
    left 0
    right 0
    height 8px
    background linear-gradient(180deg, rgba(255, 255, 255, 0.24) 0%, rgba(255, 255, 255, 0.05) 55%, transparent 100%)
    z-index 3
    pointer-events none
    border-radius 24px 24px 0 0

  &::after
    content ''
    position absolute
    bottom -100px
    right -80px
    width 360px
    height 360px
    border-radius 50%
    background radial-gradient(circle at center, rgba(255, 255, 255, 0.11) 0%, rgba(255, 255, 255, 0.05) 22%, rgba(255, 255, 255, 0.02) 45%, transparent 70%)
    pointer-events none
    z-index 1

  &:hover
    border-color rgba(255, 255, 255, 0.18) !important

  // 标签项颜色：去掉默认蓝紫渐变，改为翡翠绿
  a
    color $neon-green !important
    transition all 0.25s !important
    border-bottom 1px dashed transparent !important

    &:hover
      color lighten($neon-green, 15%) !important
      border-bottom-color $neon-green-line !important
      transform translateY(-1px) !important

// --- 3) 分类页：玻璃卡片 ---
.category-list
  position relative
  overflow hidden
  background linear-gradient(180deg, rgba(36, 39, 45, 0.5) 0%, rgba(22, 24, 28, 0.68) 100%) !important
  border 1px solid rgba(255, 255, 255, 0.06) !important
  border-radius 24px !important
  box-shadow 0 8px 32px rgba(0, 0, 0, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.08) !important
  backdrop-filter blur(26px) saturate(135%) !important
  -webkit-backdrop-filter blur(26px) saturate(135%) !important
  padding 2rem !important
  margin-bottom 1.5rem !important

  &::before
    content ''
    position absolute
    top 0
    left 0
    right 0
    height 8px
    background linear-gradient(180deg, rgba(255, 255, 255, 0.24) 0%, rgba(255, 255, 255, 0.05) 55%, transparent 100%)
    z-index 3
    pointer-events none
    border-radius 24px 24px 0 0

  &::after
    content ''
    position absolute
    bottom -100px
    right -80px
    width 360px
    height 360px
    border-radius 50%
    background radial-gradient(circle at center, rgba(255, 255, 255, 0.11) 0%, rgba(255, 255, 255, 0.05) 22%, rgba(255, 255, 255, 0.02) 45%, transparent 70%)
    pointer-events none
    z-index 1

  .category .category-collapse-toggle
    color $neon-green !important

.category-post-list
  margin 0 !important

.category-post
  background transparent !important
  border none !important
  padding 0.5rem 0 !important
  color $text-main !important

  &:hover
    color $neon-green !important

// --- 4) 分类页文章：玻璃卡片悬浮（对齐主页 tile 特效）---
.category-post-list .list-group-item
  position relative
  overflow hidden
  border-radius 16px !important
  border 1px solid rgba(255, 255, 255, 0.08) !important
  background linear-gradient(180deg, rgba(36, 39, 45, 0.5) 0%, rgba(22, 24, 28, 0.68) 100%) !important
  box-shadow 0 6px 24px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.08) !important
  transition all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important
  margin-bottom 10px !important
  padding 0.8rem 1.1rem !important

  &::before
    content ''
    position absolute
    top 0
    left 0
    right 0
    height 5px
    background linear-gradient(180deg, rgba(255, 255, 255, 0.2) 0%, rgba(255, 255, 255, 0.04) 60%, transparent 100%)
    z-index 2
    pointer-events none
    transition all 0.3s ease

  &:hover, &:focus
    border-color rgba(255, 255, 255, 0.22) !important
    background linear-gradient(180deg, rgba(40, 44, 50, 0.65) 0%, rgba(26, 28, 32, 0.8) 100%) !important
    transform translateY(-3px) !important
    box-shadow 0 12px 32px rgba(0, 0, 0, 0.55), inset 0 1px 0 rgba(255, 255, 255, 0.12) !important

    &::before
      background linear-gradient(90deg, transparent 5%, rgba(255, 255, 255, 0.38) 50%, transparent 95%) !important

  .category-post
    color $text-main !important
    transition color 0.25s ease !important

    &:hover
      color $neon-green !important

// --- 5) 搜索模态框：磨砂玻璃风 ---
.modal#modalSearch
  .modal-content
    background rgba(24, 26, 31, 0.86) !important
    border 1px solid rgba(255, 255, 255, 0.1) !important
    border-radius 20px !important
    backdrop-filter blur(26px) saturate(135%) !important
    -webkit-backdrop-filter blur(26px) saturate(135%) !important
    box-shadow 0 16px 48px rgba(0, 0, 0, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.1) !important
    color $text-main !important

  .modal-header
    border-bottom 1px solid rgba(255, 255, 255, 0.08) !important

    .modal-title
      color $text-main !important

    .close
      color $text-main !important
      text-shadow none !important
      opacity 0.7

      &:hover
        opacity 1
        color $neon-green !important

  .md-form
    label
      color rgba(255, 255, 255, 0.5) !important

    input.form-control
      background rgba(255, 255, 255, 0.06) !important
      border 1px solid rgba(255, 255, 255, 0.14) !important
      border-radius 12px !important
      color $text-main !important
      box-shadow none !important
      padding 0.6rem 1rem !important
      transition all 0.25s ease !important

      &:focus
        border-color rgba(255, 255, 255, 0.3) !important
        background rgba(255, 255, 255, 0.09) !important
        box-shadow 0 0 0 3px rgba(34, 197, 94, 0.12) !important

    .form-control:focus + label, .form-control:valid + label
      color $neon-green !important
      transform translateY(-1.5rem) scale(0.85) !important

  #local-search-result
    .list-group-item
      background rgba(255, 255, 255, 0.04) !important
      border 1px solid rgba(255, 255, 255, 0.06) !important
      border-radius 10px !important
      color $text-main !important
      margin-bottom 8px !important
      transition all 0.25s ease !important

      &:hover
        background rgba(255, 255, 255, 0.09) !important
        border-color rgba(255, 255, 255, 0.16) !important
        transform translateX(3px) !important
        color $neon-green !important

      a
        color $text-main !important

      &:hover a
        color $neon-green !important

// --- 6) 友链页：卡片玻璃化 ---
// 关键：.links 和 .row 是同一个 div（class="row links"），不是父子关系
// 覆盖 Fluid main.css 的 .links { display:flex; flex-direction:column; align-items:center }
.links
  display flex !important
  flex-wrap wrap !important
  justify-content flex-start !important
  align-items stretch !important
  background transparent !important
  margin 0 !important
  padding 0 !important

.links > .card
  position relative
  overflow hidden
  background linear-gradient(180deg, rgba(36, 39, 45, 0.55) 0%, rgba(22, 24, 28, 0.72) 100%) !important
  border 1px solid rgba(255, 255, 255, 0.06) !important
  border-radius 24px !important
  box-shadow 0 8px 32px rgba(0, 0, 0, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.08) !important
  backdrop-filter blur(26px) saturate(135%) !important
  -webkit-backdrop-filter blur(26px) saturate(135%) !important
  transition all 0.35s cubic-bezier(0.4, 0, 0.2, 1) !important
  // 百分比宽度 + margin，避免被 col-md-10 内部宽度不确定性影响
  // 必须覆盖 Fluid main.css 的 .links .card { min-width: 33% }
  box-sizing border-box !important
  width 31% !important
  max-width 31% !important
  min-width 0 !important
  margin-right 1.5% !important
  margin-bottom 0 !important
  padding 0 !important
  flex none !important

  &:last-child
    margin-right 0 !important

  @media (max-width 991.98px)
    width 48% !important
    max-width 48% !important
    &:nth-child(2n),
    &:last-child
      margin-right 0 !important

  @media (max-width 575.98px)
    width 100% !important
    max-width 100% !important
    margin-right 0 !important
  // 去掉头像图片：卡片只保留文字，更简洁
  .link-avatar
    display none !important

  .card-body
    padding 0.6rem 1.1rem !important

  .card-content
    height auto !important
    min-height 0 !important
    display block !important
    width 100% !important

  &::before
    content ''
    position absolute
    top 0
    left 0
    right 0
    height 8px
    background linear-gradient(180deg, rgba(255, 255, 255, 0.24) 0%, rgba(255, 255, 255, 0.05) 55%, transparent 100%)
    z-index 3
    pointer-events none
    border-radius 24px 24px 0 0

  &::after
    content ''
    position absolute
    bottom -80px
    right -60px
    width 320px
    height 320px
    border-radius 50%
    background radial-gradient(circle at center, rgba(255, 255, 255, 0.1) 0%, rgba(255, 255, 255, 0.03) 25%, transparent 65%)
    pointer-events none
    z-index 1

  &:hover
    transform translateY(-4px) !important
    border-color rgba(255, 255, 255, 0.2) !important
    box-shadow 0 12px 32px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.12) !important

  .card-body
    background transparent !important
    color $text-main !important

  .link-title
    color $text-main !important

    &:hover
      color $neon-green !important

  .link-intro
    color $text-dim !important

// 友链分组标题
.links .custom h2, .links .card-header
  color $neon-green !important
  background transparent !important
  border-bottom 1px solid rgba(255, 255, 255, 0.1) !important

// --- 5) 关于页（重构：与主页模块卡片 .tile 同款玻璃质感，无遮挡问题）---
// 关键：导航栏已改为完全不透明背景，内容永远无法透过导航栏显示。
//     关于内容卡片使用与主页 .tile 完全一致的样式（渐变玻璃 + 阴影 + 圆角）。
.about-content.page-content
  margin-top 88px
  overflow hidden
  border-radius 24px
  border 1px solid rgba(255, 255, 255, 0.06)
  background linear-gradient(180deg, rgba(36, 39, 45, 0.55) 0%, rgba(22, 24, 28, 0.72) 100%)
  backdrop-filter blur(26px) saturate(135%)
  -webkit-backdrop-filter blur(26px) saturate(135%)
  box-shadow 0 8px 32px rgba(0, 0, 0, 0.55), inset 0 1px 0 rgba(255, 255, 255, 0.1)
  padding 3rem

  // 顶部玻璃高光（同 .tile ::before）
  &::before
    content ''
    position absolute
    top 0
    left 0
    right 0
    height 8px
    background linear-gradient(180deg, rgba(255, 255, 255, 0.24) 0%, rgba(255, 255, 255, 0.05) 55%, transparent 100%)
    z-index 3
    pointer-events none

  // 右下角弧形光弧（同 .tile ::after）
  &::after
    content ''
    position absolute
    bottom -100px
    right -80px
    width 360px
    height 360px
    border-radius 50%
    background radial-gradient(circle at center, rgba(255, 255, 255, 0.11) 0%, rgba(255, 255, 255, 0.05) 22%, rgba(255, 255, 255, 0.02) 45%, transparent 70%)
    pointer-events none
    z-index 1

  .about-name, .about-content .markdown-body
    color $text-main !important

  .about-intro
    color $text-dim !important
    white-space pre-line // 支持 intro 配置中的 \n 换行（两行诗句）

  .about-icons a
    color $text-main !important

    &:hover
      color $neon-green !important

// 关于页正文区域
.about-content .markdown-body
  background transparent !important
  color $text-main !important

// --- 6) 404 页：内容卡片玻璃化 ---
.nf-text
  position relative
  overflow hidden
  background linear-gradient(180deg, rgba(36, 39, 45, 0.55) 0%, rgba(22, 24, 28, 0.72) 100%) !important
  border 1px solid rgba(255, 255, 255, 0.06) !important
  border-radius 24px !important
  box-shadow 0 8px 32px rgba(0, 0, 0, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.08) !important
  backdrop-filter blur(26px) saturate(135%) !important
  -webkit-backdrop-filter blur(26px) saturate(135%) !important
  padding 3rem 2rem !important
  margin 2rem auto !important

  &::before
    content ''
    position absolute
    top 0
    left 0
    right 0
    height 8px
    background linear-gradient(180deg, rgba(255, 255, 255, 0.24) 0%, rgba(255, 255, 255, 0.05) 55%, transparent 100%)
    z-index 3
    pointer-events none
    border-radius 24px 24px 0 0

  h1
    color $neon-green !important
