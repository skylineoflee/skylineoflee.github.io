// ============================================================================
// 首页模块化样式（WenXiBuddy 风格重构 v2 —— 排版对齐）
// 风格：深色玻璃拟态 + 翡翠绿主色调 + 双栏布局 + 3D 扇形 hero
// ============================================================================

// --- 调色板（WenXiBuddy 风格）---
$bg-base        = #0A0A0B       // 主背景（近黑深灰）
$bg-base-1      = #0A0A0B       // 主背景起点
$bg-base-2      = #14141A       // 主背景终点（暖深灰）
$bg-panel       = rgba(28, 30, 33, 0.6)   // 面板底色（暖灰玻璃，半透明）
$bg-glass       = rgba(20, 21, 26, 0.55) // 玻璃卡片底色（统一）
$bg-panel-hover = rgba(30, 30, 34, 0.75)  // 面板悬浮
$border         = rgba(255, 255, 255, 0.08)  // 默认边框
$border-hover   = rgba(255, 255, 255, 0.35)   // 悬浮边框（绿）
$neon-green     = #22C55E       // 主品牌色（翡翠绿）
$neon-green-soft = rgba(255, 255, 255, 0.18)
$neon-green-line = rgba(255, 255, 255, 0.18)
$neon-green-glow = rgba(255, 255, 255, 0.18)
$accent-red     = #EF4444       // 警示色（逾期/警告）
$text-main      = #E8E8EA       // 正文（高亮白）
$text-dim       = #8A8A92       // 次级文字
$mono-font      = 'JetBrains Mono', 'Fira Code', 'Consolas', monospace

// ============================================================================
// ============================================================================
// 全站艺术级氛围背景系统（Art-Grade Ambient Background）
// 覆盖：body 渐变底色 + 多层 radial-gradient 极光 + 细密星点
// 范围：所有页面（首页/文章页/归档/标签/分类/友链/关于/404）
// 设计：7 个角落径向光晕（翡翠绿/冷蓝紫/琥珀橙/品红紫/青绿/冷青/暖紫）
//       + 1 层细微 noise（细密星点），全部 fixed 不滚动
// ============================================================================

// --- 1) 呼吸动画（氛围层缓慢脉动，12s 循环）---
@keyframes aurora-breathe
  0%
    opacity 0.85
    transform scale(1) translate(0, 0)
  50%
    opacity 1
    transform scale(1.03) translate(-1%, 0.5%)
  100%
    opacity 0.85
    transform scale(1) translate(0, 0)

// --- 2) 星点漂移动画（细密层轻微位移）---
@keyframes starfield-drift
  0%
    transform translate(0, 0)
  50%
    transform translate(-0.5%, 0.3%)
  100%
    transform translate(0, 0)

// --- 3) 全局 body：深色渐变底色 + 固定背景（用 html 元素承担，body 自然延伸）---
html
  background-color $bg-base-1 !important
  background-image linear-gradient(180deg, $bg-base-1 0%, $bg-base-2 100%) !important
  background-attachment fixed !important // 背景固定不随滚动，避免滚动时底色跟着跑

body
  background-color transparent !important
  background-image none !important
  color $text-main !important
  position static !important
  min-height 100vh !important
  // body 高度由内容自然撑开

  // 唯一氛围层：与卡片磨砂风格统一的中性光晕
  &::before
    content ''
    position fixed
    inset 0
    pointer-events none
    z-index 0
    background:
      radial-gradient(ellipse 600px 400px at 20% -5%, rgba(34, 197, 94, 0.06), transparent 70%),
      radial-gradient(ellipse 700px 450px at 90% 100%, rgba(255, 255, 255, 0.025), transparent 70%)
    animation aurora-breathe 18s ease-in-out infinite
    will-change transform, opacity

  // 第二层氛围：细密星点（subtle noise）
  &::after
    content ''
    position fixed
    inset 0
    pointer-events none
    z-index 0
    opacity 0.4
    background:
      radial-gradient(circle 1px at 12% 18%, rgba(255,255,255,0.5), transparent 60%),
      radial-gradient(circle 1px at 28% 35%, rgba(255,255,255,0.35), transparent 60%),
      radial-gradient(circle 1px at 45% 12%, rgba(255,255,255,0.45), transparent 60%),
      radial-gradient(circle 1px at 65% 28%, rgba(255,255,255,0.30), transparent 60%),
      radial-gradient(circle 1px at 82% 16%, rgba(255,255,255,0.50), transparent 60%),
      radial-gradient(circle 1px at 92% 42%, rgba(255,255,255,0.35), transparent 60%),
      radial-gradient(circle 1px at 18% 62%, rgba(255,255,255,0.40), transparent 60%),
      radial-gradient(circle 1px at 35% 78%, rgba(255,255,255,0.30), transparent 60%),
      radial-gradient(circle 1px at 58% 85%, rgba(255,255,255,0.45), transparent 60%),
      radial-gradient(circle 1px at 75% 72%, rgba(255,255,255,0.35), transparent 60%),
      radial-gradient(circle 1px at 88% 88%, rgba(255,255,255,0.40), transparent 60%),
      radial-gradient(circle 1px at 8% 92%, rgba(255,255,255,0.30), transparent 60%),
      radial-gradient(circle 1px at 50% 50%, rgba(255,255,255,0.25), transparent 60%),
      radial-gradient(circle 1px at 70% 8%, rgba(255,255,255,0.40), transparent 60%),
      radial-gradient(circle 1px at 22% 48%, rgba(255,255,255,0.30), transparent 60%)
    background-repeat no-repeat
    animation starfield-drift 60s ease-in-out infinite

  > *:not(.bg-orbs):not(.modal):not(.modal-backdrop)
    position relative
    z-index 1

  font-family -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, 'PingFang SC', 'Microsoft YaHei', sans-serif !important

// --- 2) Banner：透明透出 body 渐变 ---
#banner, .banner
  background transparent !important
  background-image none !important
  height auto !important
  min-height 240px !important
  padding 0 !important
  position relative

  .full-bg-img
    background transparent !important

  .mask
    position absolute !important
    background transparent !important
    height 100% !important
    width 100% !important
    top 0 !important
    left 0 !important
    display flex !important
    align-items center !important
    justify-content center !important
    padding 0 !important

  .banner-text
    display block !important
    position relative
    z-index 1
    opacity 1 !important
    animation none !important
    transform none !important
    padding 2.5rem 1rem 1.5rem !important

  #subtitle
    color $text-main !important
    font-size 28px !important
    font-weight 700 !important
    line-height 1.3 !important

  .post-meta
    color rgba(232,232,234,0.7) !important
    font-size 14px !important
    i
      margin-right 4px
      opacity 0.7

// --- 3) #board 内容容器：透明透出氛围，且不创建 stacking context ---
#board
  position relative !important
  z-index auto !important
  background transparent !important
  box-shadow none !important
  padding 0 !important
  margin-top 0 !important
  border-radius 0 !important

  .container, .row, .col-lg-8
    background transparent !important

// --- 4) post-content 文章正文：玻璃卡片（统一卡片风格）---
.post-content
  background $bg-glass !important
  background-color $bg-glass !important
  border 1px solid rgba(255, 255, 255, 0.06) !important
  border-radius 24px !important
  padding 2.5rem 3rem !important
  box-shadow 0 8px 32px rgba(0, 0, 0, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.08) !important
  backdrop-filter blur(20px) saturate(140%) !important
  -webkit-backdrop-filter blur(20px) saturate(140%) !important
  position relative
  overflow hidden

  &::before
    content ''
    position absolute
    top 0
    left 0
    right 0
    height 8px
    background linear-gradient(180deg, rgba(255, 255, 255, 0.22) 0%, rgba(255, 255, 255, 0.04) 60%, transparent 100%)
    border-radius 24px 24px 0 0
    z-index 3
    pointer-events none

  @media (max-width 767px)
    padding 1.5rem 1.25rem !important
    border-radius 18px !important

// header 区域也玻璃化


// ============================================================================
// ============================================================================
// 全局：深色背景 + 氛围光晕
// ============================================================================
// --- 真正修复：<header> 是 navbar 的父元素，必须提到最高层级 ---
body > header
  z-index 2147483647 !important

// --- 修复：搜索 modal 打开时，header（含 banner 标题）必须让位 ---
//      modal 在 <main> 内（z-index 1 上下文），若 header 保持最高层，
//      banner 的标题会盖住 modal 输入框，导致点击无法聚焦输入。
//      1040 = Bootstrap backdrop 层，低于 modal(1050)、高于页面内容(1)。
body.modal-open > header
  z-index 1040 !important

body.home-page
  background $bg-base-1 linear-gradient(180deg, $bg-base-1 0%, $bg-base-2 100%) !important
  background-attachment fixed !important // 背景固定不随滚动
  min-height 100vh
  position relative
  overflow-x hidden

  // 装饰层：继承全局氛围（不覆盖 ::before，沿用 body 的全局光晕）
  // 排除 .modal：保持 position fixed，避免滚动后搜索框不可用
  // 排除 .modal-backdrop：保持 Bootstrap 默认 fixed 遮罩（z-index 1040）
  > *:not(.bg-orbs):not(.modal):not(.modal-backdrop)
    position relative
    z-index 1

  #board
    background transparent !important
    box-shadow none !important
    margin-top 0 !important
    padding-top 76px !important

  #board > .container > .row > .col-12
    max-width 1440px !important
    flex 0 0 100% !important
    padding 0 32px !important

    @media (max-width 768px)
      padding 0 16px !important

  .header-inner
    height 0 !important
    min-height 0 !important
    padding 0 !important
    margin 0 !important

  // 顶部导航栏：最高优先级，永远在最上层
  .navbar, header.navbar
    top 0 !important
    right 0 !important
    left 0 !important
    position fixed !important
    z-index 2147483647 !important
    transform translateZ(0) !important
    will-change transform !important
    contain layout style paint !important
    background linear-gradient(180deg, #24272D 0%, #16181C 100%) !important
    backdrop-filter blur(26px) saturate(135%) !important
    -webkit-backdrop-filter blur(26px) saturate(135%) !important
    border-bottom 1px solid rgba(255, 255, 255, 0.06) !important
    box-shadow 0 8px 32px rgba(0, 0, 0, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.1) !important
    border-radius 0 0 20px 20px !important
    margin 0 !important
    width 100% !important
    max-width 100% !important

  .navbar.scrolling-navbar.top-nav-collapse
    background linear-gradient(180deg, rgba(36, 39, 45, 0.75) 0%, rgba(22, 24, 28, 0.85) 100%) !important
    backdrop-filter blur(26px) saturate(135%) !important
    box-shadow 0 8px 32px rgba(0, 0, 0, 0.55), inset 0 1px 0 rgba(255, 255, 255, 0.12) !important

  // 搜索 modal 打开时，导航栏让位（保证 modal 输入框可点击）
  &.modal-open .navbar, &.modal-open header.navbar
    z-index 1040 !important

  main
    position static !important
    z-index auto !important

  #board
    position static !important
    z-index auto !important

  #banner
    display none !important

  .tile-link
    display block
    color inherit
    text-decoration none

  main
    background transparent !important

// 背景光晕呼吸
@keyframes bg-pulse
  0%
    opacity 1
    transform scale(1)
  100%
    opacity 0.75
    transform scale(1.04)

// 漂浮光斑漂移
@keyframes orb-drift
  0%
    transform translate(0, 0) scale(1)
  50%
    transform translate(-9vw, 14vh) scale(1.12)
  100%
    transform translate(-4vw, 7vh) scale(0.96)

// ============================================================================
// 双栏布局
// ============================================================================
.home-layout
  display grid
  grid-template-columns 320px minmax(0, 1fr)
  gap 32px
  align-items start
  padding-bottom 48px

  @media (max-width 1080px)
    grid-template-columns 1fr

// 主内容区
.home-main
  min-width 0
  order 2

  // 单列布局（移动端）时正文在前、侧栏面板在后，避免 4 张侧栏卡把文章挤出首屏
  @media (max-width 1080px)
    order 1

// 右侧固定面板
.home-side
  position sticky
  top 84px // 67px 固定导航栏 + 17px 间距，滚动时避免卡片钻到导航栏底下
  order 1
  display flex
  flex-direction column
  gap 20px
  align-self start

  // 修复：原先这里用 max-height calc(100vh - 100px) + overflow-y auto 做侧栏内部滚动，
  // 但四张卡合计约 950px，超过多数浏览器视口高度，滚动容器会把最后一张卡（标签云）
  // 的下边框裁掉、内容显示不全。改为：视口足够高时才 sticky，否则退化为静态，
  // 交给页面滚动浏览，绝不裁切内容。
  @media (max-height 1060px)
    position static

  @media (max-width 1080px)
    position static
    order 2
    display grid
    grid-template-columns repeat(2, 1fr)
    gap 16px

  @media (max-width 640px)
    grid-template-columns 1fr

// 侧栏卡片（灰色磨砂玻璃）
.side-card
  background linear-gradient(180deg, rgba(42, 45, 50, 0.6) 0%, rgba(28, 30, 33, 0.65) 100%)
  backdrop-filter blur(24px) saturate(130%)
  -webkit-backdrop-filter blur(24px) saturate(130%)
  border 1px solid rgba(255, 255, 255, 0.06)
  border-radius 16px
  padding 20px
  position relative
  overflow hidden
  transition all 0.3s
  box-shadow 0 4px 16px rgba(0, 0, 0, 0.2), inset 0 1px 0 rgba(255, 255, 255, 0.08)

  &::before
    content ''
    position absolute
    top 0
    left 0
    right 0
    height 1px
    background linear-gradient(90deg, transparent 5%, rgba(255, 255, 255, 0.18) 50%, transparent 95%)

  &:hover
    border-color rgba(255, 255, 255, 0.18)

// 侧栏卡片标题
.side-card-title
  font-family $mono-font
  font-size 13px
  font-weight 600
  color $text-main
  letter-spacing 0.12em
  margin-bottom 16px
  display flex
  align-items center
  gap 8px

  &::before
    content ''
    width 6px
    height 6px
    border-radius 1px
    background rgba(255, 255, 255, 0.6)
    box-shadow 0 0 8px $neon-green-glow

.side-card-title-en
  font-size 11px
  color $text-dim
  letter-spacing 0.08em
  font-weight 400

// --- 名片卡 ---
.side-profile-top
  display flex
  align-items center
  gap 14px
  margin-bottom 14px

.side-avatar
  width 56px
  height 56px
  border-radius 50%
  border 2px solid rgba(255, 255, 255, 0.2)
  object-fit cover
  box-shadow 0 0 16px rgba(0, 0, 0, 0.4)
  flex-shrink 0

.side-profile-name
  display flex
  flex-direction column
  gap 4px
  min-width 0

.side-name
  font-size 17px
  font-weight 700
  color $text-main

.side-role
  font-family $mono-font
  font-size 11px
  color $neon-green
  letter-spacing 0.08em

.side-intro
  font-size 13px
  color $text-dim
  line-height 1.6
  margin 0 0 14px
  white-space pre-line // 支持 intro 配置中的 \n 换行（两行诗句）

.side-social
  display flex
  gap 8px

  a
    width 32px
    height 32px
    border-radius 8px
    background rgba(255, 255, 255, 0.06)
    color $text-dim
    display inline-flex
    align-items center
    justify-content center
    font-size 14px
    transition all 0.25s
    border 1px solid transparent

    &:hover
      background rgba(255, 255, 255, 0.92)
      color $bg-base
      border-color rgba(255, 255, 255, 0.5)
      box-shadow 0 4px 14px rgba(0, 0, 0, 0.5)
      transform translateY(-2px)

// --- 统计卡 ---
.side-stats
  display grid
  grid-template-columns repeat(3, 1fr)
  gap 8px

.side-stat
  display flex
  flex-direction column
  align-items center
  gap 6px
  padding 14px 8px
  border-radius 10px
  background rgba(255, 255, 255, 0.04)
  border 1px solid rgba(255, 255, 255, 0.05)
  transition all 0.25s

  &:hover
    background $neon-green-soft
    border-color $neon-green-line

.side-stat-num
  font-family $mono-font
  font-size 22px
  font-weight 700
  color $text-main
  line-height 1

.side-stat-label
  font-size 11px
  color $text-dim

// --- 最新文章卡 ---
.side-recent-list
  list-style none
  margin 0
  padding 0

  li
    margin 0

.side-recent-item
  display flex
  align-items center
  gap 12px
  padding 10px 0
  border-bottom 1px solid rgba(255, 255, 255, 0.05)
  transition all 0.2s
  text-decoration none

  &:hover
    .side-recent-title
      color $neon-green

  &:last-child
    border-bottom none

.side-recent-index
  font-family $mono-font
  font-size 12px
  color $text-dim
  flex-shrink 0
  width 24px
  text-align right
  opacity 0.6

.side-recent-text
  display flex
  flex-direction column
  gap 2px
  min-width 0

.side-recent-title
  font-size 13px
  color $text-main
  line-height 1.4
  transition color 0.2s
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

.side-recent-date
  font-family $mono-font
  font-size 11px
  color $text-dim
  opacity 0.7

// --- 标签云卡 ---
.side-tag-cloud
  display flex
  flex-wrap wrap
  gap 8px

.side-tag
  font-size 12px
  padding 5px 12px
  border-radius 6px
  background rgba(255, 255, 255, 0.05)
  color $text-dim
  border 1px solid rgba(255, 255, 255, 0.07)
  transition all 0.2s
  text-decoration none
  font-family $mono-font

  &:hover
    background $neon-green-soft
    color $neon-green
    border-color $neon-green-line
    transform translateY(-1px)

// 标签大小随文章数变化（data-count 越大字体越大）
.side-tag[data-count="12"]
  font-size 13px

.side-tag[data-count="10"],
.side-tag[data-count="11"]
  font-size 12.5px

.side-tag[data-count="8"],
.side-tag[data-count="9"]
  font-size 12px

// ============================================================================
// 模块系统
// ============================================================================
.module
  margin-top 48px
  position relative

  &:first-child
    margin-top 8px

.module-head
  display flex
  align-items baseline
  justify-content space-between
  margin-bottom 20px
  padding-bottom 14px
  border-bottom 1px solid rgba(255, 255, 255, 0.06)
  position relative

  &::after
    content ''
    position absolute
    bottom -1px
    left 0
    width 60px
    height 2px
    background linear-gradient(90deg, rgba(255, 255, 255, 0.6), transparent)

.module-title
  font-size 17px
  font-weight 600
  margin 0
  color $text-main
  letter-spacing -0.01em
  display flex
  align-items center
  gap 12px

  &::before
    content ''
    width 8px
    height 8px
    border-radius 2px
    background rgba(255, 255, 255, 0.7)
    box-shadow 0 0 12px rgba(255, 255, 255, 0.2)

.module-name-en
  font-size 11px
  color $text-dim
  letter-spacing 0.15em
  font-weight 400
  margin-left 4px
  text-transform uppercase

.module-subtitle
  font-size 13px
  color $text-dim
  margin 0

.module-more
  font-size 13px
  color $neon-green
  padding 6px 14px
  border-radius 8px
  border 1px solid rgba(255, 255, 255, 0.2)
  background transparent
  transition all 0.25s

  &:hover
    background rgba(255, 255, 255, 0.92)
    color $bg-base
    box-shadow 0 4px 16px rgba(0, 0, 0, 0.5)

// 主区卡片网格：2 列紧凑（WenXiBuddy 信息密度）
.module-grid
  display grid
  gap 14px
  grid-template-columns repeat(2, 1fr)

  @media (max-width 1200px)
    grid-template-columns 1fr

  @media (max-width 1080px)
    grid-template-columns repeat(2, 1fr)

  @media (max-width 640px)
    grid-template-columns 1fr

// ----------------------------------------------------------------------------
// 通用卡片（玻璃拟态风格）
// ----------------------------------------------------------------------------
// 通用卡片（灰色磨砂玻璃——WenXiBuddy 统计卡质感）
// ============================================================================
// 子页 banner 压缩（归档/分类/标签/友链/404）
// 无 banner 图时 header 默认 60vh 只放一个标题，下方大片空白；压缩到 280px
// 文章页 banner 自带合适高度，用 :has(.post-content) 排除
// ============================================================================
body:not(:has(.post-content)) #banner.banner
  height 280px !important
  min-height 200px
  max-height 40vh

body:not(:has(.post-content)) header:has(#banner.banner)
  height 280px !important
  min-height 200px
  max-height 40vh

// .header-inner 由 header.ejs 写入 inline height:60vh，header/banner 压到 280px 后
// 这个透明容器会溢出悬在内容上方挡住点击（归档页文章点不动就是这个原因），必须一并压缩
body:not(:has(.post-content)) header:has(#banner.banner) .header-inner
  height 280px !important
  min-height 200px
  max-height 40vh

// 标签页按钮：默认中性字色，悬浮只变字色、不带下划线（#board .text-center 下的裸链接）
#board .text-center > a
  color $text-dim !important
  border-color transparent !important
  border-bottom none !important
  transition color .2s ease

  &:hover
    color $neon-green !important

// 关于页头像下的 about-intro（位于 .about-info 内，不在 .about-content 作用域）：
// 配置的 intro 含 \n，默认 white-space 会折叠成一行，需 pre-line 两行展示
.about-intro
  white-space pre-line

// 关于页：主题给头像 margin-top -8rem 的上拉设计（按 60vh banner 调的），
// banner 压缩到 280px 后上拉过头会压住标题，收窄为 -5rem
body:not(:has(.post-content)) .about-avatar
  margin-top -5rem

.tile
  position relative
  overflow hidden
  border-radius 24px
  border 1px solid rgba(255, 255, 255, 0.06)
  background linear-gradient(180deg, rgba(36, 39, 45, 0.55) 0%, rgba(22, 24, 28, 0.72) 100%)
  backdrop-filter blur(26px) saturate(135%)
  -webkit-backdrop-filter blur(26px) saturate(135%)
  box-shadow 0 8px 32px rgba(0, 0, 0, 0.55), inset 0 1px 0 rgba(255, 255, 255, 0.1)
  transition all 0.35s cubic-bezier(0.4, 0, 0.2, 1)

  // 顶部玻璃高光（厚 8px，向上衰减）
  &::before
    content ''
    position absolute
    top 0
    left 0
    right 0
    height 8px
    background linear-gradient(180deg, rgba(255, 255, 255, 0.24) 0%, rgba(255, 255, 255, 0.05) 55%, transparent 100%)
    z-index 3
    pointer-events none

  // 右下角弧形光弧（WenXiBuddy 玻璃质感特征）
  &::after
    content ''
    position absolute
    bottom -100px
    right -80px
    width 360px
    height 360px
    border-radius 50%
    background radial-gradient(circle at center, rgba(255, 255, 255, 0.11) 0%, rgba(255, 255, 255, 0.05) 22%, rgba(255, 255, 255, 0.02) 45%, transparent 70%)
    pointer-events none
    z-index 1
  &:hover
    border-color rgba(255, 255, 255, 0.18)
    transform translateY(-4px)
    box-shadow 0 10px 28px rgba(0, 0, 0, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.12)

    &::before
      background linear-gradient(90deg, transparent 5%, rgba(255, 255, 255, 0.4) 50%, transparent 95%)

    .tile-title
      color $neon-green

// 封面区域（项目/视频/游戏卡片——对齐 WXB 玻璃质感）
.tile-cover
  position relative
  height 88px
  background-size cover
  background-position center
  border-radius 24px 24px 0 0
  overflow hidden

  &::after
    content ''
    position absolute
    inset 0
    background linear-gradient(to bottom, rgba(0,0,0,0) 0%, rgba(0,0,0,0.1) 50%, rgba(10, 10, 11, 0.85) 100%)

.tile-body
  padding 18px 20px 20px

// 标题行
.tile-head
  display flex
  align-items flex-start
  justify-content space-between
  gap 8px
  margin-bottom 8px

.tile-title
  font-size 15px
  font-weight 600
  color $text-main
  line-height 1.4
  margin 0
  display -webkit-box
  -webkit-line-clamp 1
  line-clamp 1
  -webkit-box-orient vertical
  overflow hidden
  text-overflow ellipsis
  transition color 0.25s
  flex 1
  min-width 0

.tile-cat
  flex-shrink 0
  font-size 11px
  padding 4px 10px
  border-radius 6px
  background rgba(255, 255, 255, 0.06)
  color rgba(255, 255, 255, 0.85)
  font-family $mono-font
  border 1px solid rgba(255, 255, 255, 0.08)
  letter-spacing 0.02em
  white-space nowrap

.tile-excerpt
  font-size 13px
  color $text-dim
  line-height 1.6
  margin 0 0 12px
  display -webkit-box
  -webkit-line-clamp 2
  line-clamp 2
  -webkit-box-orient vertical
  overflow hidden
  text-overflow ellipsis

.tile-meta
  display flex
  align-items center
  gap 8px
  font-size 12px
  color $text-dim
  font-family $mono-font
  margin-bottom 10px

  time, span
    display inline-flex
    align-items center
    gap 4px

  i
    font-size 12px

  .dot
    color alpha($text-dim, 0.4)

.tile-tags
  display flex
  flex-wrap wrap
  gap 6px

.chip
  font-size 11px
  padding 4px 10px
  border-radius 6px
  background rgba(255, 255, 255, 0.05)
  color rgba(255, 255, 255, 0.65)
  font-family $mono-font
  border 1px solid rgba(255, 255, 255, 0.06)
  transition all 0.2s

  &:hover
    background rgba(255, 255, 255, 0.12)
    color #fff
    border-color rgba(255, 255, 255, 0.18)
    transform translateY(-1px)

.chip-more
  background transparent
  color alpha($text-dim, 0.6)
  border 1px dashed rgba(255, 255, 255, 0.15)
  cursor default

  &:hover
    background transparent
    color alpha($text-dim, 0.6)
    border-color rgba(255, 255, 255, 0.15)
    transform none

// 模块类型边条（2px 中性白，hover 时变亮——不强夺视觉）
.module-projects .tile, .module-videos .tile, .module-games .tile, .module-posts .tile
  border-left-width 2px

.module-projects .tile
  border-left-color rgba(255, 255, 255, 0.25)

.module-videos .tile
  border-left-color rgba(255, 255, 255, 0.15)

.module-games .tile
  border-left-color rgba(255, 255, 255, 0.4)

.module-posts .tile
  border-left-color rgba(255, 255, 255, 0.2)

// 状态标签
.tile-status
  display inline-flex
  align-items center
  padding 3px 9px
  font-size 10px
  font-family $mono-font
  letter-spacing 0.05em
  border-radius 5px
  background rgba(255, 255, 255, 0.08)
  border 1px solid rgba(255, 255, 255, 0.14)
  margin-bottom 10px

  // 状态：所有背景统一中性玻璃底，仅文字保留语义色
  &.status-active
    color rgba(255, 255, 255, 0.95)
    border-color rgba(255, 255, 255, 0.3)
    background rgba(255, 255, 255, 0.1)

  &.status-wip
    color #F59E0B
    border-color rgba(245, 158, 11, 0.18)
    background rgba(245, 158, 11, 0.04)

  &.status-archived
    color alpha($text-dim, 0.6)
    border-color rgba(255, 255, 255, 0.05)
    background transparent

  &.status-playable
    color rgba(255, 255, 255, 0.85)
    border-color rgba(255, 255, 255, 0.2)
    background rgba(255, 255, 255, 0.06)

.tile-platform
  display inline-block
  margin-top 8px
  padding 4px 10px
  font-size 11px
  font-family $mono-font
  border-radius 6px
  background rgba(255, 255, 255, 0.06)
  color $text-dim
  border 1px solid rgba(255, 255, 255, 0.1)

.tile-rating
  display flex
  align-items center
  gap 4px
  font-family $mono-font
  font-size 12px
  color $neon-green
  margin-top 8px

// 分页
#pagination
  display flex
  justify-content center
  margin-top 32px
  font-family $mono-font

  .page-number, .pagination a, .pagination span
    color $text-main !important
    border-radius 8px !important
    background $bg-panel !important
    border 1px solid $border !important
    padding 8px 14px !important
    margin 0 4px !important
    transition all 0.2s

    &:hover
      border-color rgba(255, 255, 255, 0.25) !important
      box-shadow none
      color $neon-green !important

  .pagination .current
    background rgba(255, 255, 255, 0.9) !important
    color $bg-base !important
    border-color rgba(255, 255, 255, 0.4) !important
    font-weight 600

// ============================================================================
// 滚动条
// ============================================================================
::-webkit-scrollbar
  width 8px
  height 8px

::-webkit-scrollbar-track
  background $bg-base

::-webkit-scrollbar-thumb
  background rgba(255, 255, 255, 0.15)
  border-radius 4px

  &:hover
    background $neon-green-line

// ============================================================================
// 全局悬浮提示 tooltip
// ============================================================================
[data-tip],
[title]:not([title=""]):not([title="Toggle navigation"]):not([title="Search"]):not([title="Color Toggle"]):not([title="TOP"])
  position relative

  &::after
    content attr(data-tip) attr(title)
    position absolute
    bottom calc(100% + 10px)
    left 50%
    transform translateX(-50%) translateY(4px)
    padding 8px 14px
    background rgba(15, 15, 17, 0.95)
    color $text-main
    font-size 12px
    border 1px solid $border
    border-radius 8px
    white-space nowrap
    opacity 0
    pointer-events none
    transition opacity 0.2s ease, transform 0.2s ease
    z-index 9999
    box-shadow 0 8px 24px rgba(0, 0, 0, 0.5)
    backdrop-filter blur(8px)

// ============================================================================
// 文章页（深色玻璃风格）
// ============================================================================

// 颜色变量（文章页作用域，已被全局背景接管）
$border-line   = rgba(255, 255, 255, 0.1)
$border-green  = rgba(255, 255, 255, 0.18)

// 4) 文章标题
#seo-header
  color $text-main !important
  margin-top 0.3em !important
  margin-bottom 0.6em !important
  padding-bottom 0.5em !important
  line-height 1.35 !important
  font-size 1.85rem !important
  border-bottom 1px solid $border-green !important
  font-weight 700 !important

// banner 内元信息位置
#banner
  position relative !important

  .mask.flex-center
    padding-top 32px !important



@media (max-width 768px)
  #banner .mask.flex-center
    padding-top 28px !important

  #banner .banner-text > div:nth-child(2),
  #banner .banner-text > div:nth-child(3)
