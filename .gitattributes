# 统一文本文件行尾为 LF，避免 Windows / Linux 混用导致 diff 乱码
* text=auto

# 明确声明 UTF-8 文本文件
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.js text eol=lf
*.css text eol=lf
*.styl text eol=lf
*.ejs text eol=lf
*.json text eol=lf
*.html text eol=lf

# 二进制文件
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.svg text eol=lf
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
